# Copy this file to `.env` (same folder), then start JupyterLab.
#   macOS/Linux:  cp .env.example .env
#   Windows:      copy .env.example .env
#
# The Supabase values below are the SHARED demo project. The publishable
# ("anon") key is safe to be public — row-level security protects the data —
# so with this file copied to `.env` the app runs in CONNECTED mode out of the
# box (real login, courses, leaderboard, teacher analytics). No extra setup.
SUPABASE_URL=https://wzooaiwmnsqvxxcoormp.supabase.co
SUPABASE_ANON_KEY=sb_publishable_HcZ7s3WcO2HJD84XHVS3Yg_ZP19IhfR

# OPTIONAL — enables real AI generations instead of the built-in demo output.
# A Google Gemini key OR an Anthropic key (starts with sk-ant-) both work.
GEMINI_API_KEY=

# OPTIONAL — text-to-speech in the reader.
ELEVENLABS_API_KEY=
